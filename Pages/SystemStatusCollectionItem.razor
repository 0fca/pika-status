@inject Services.MessageService MessageService
@using PikaStatus.Components


@if (_isLoaded)
{
    <article class="pika-status-item">
        <div>
            <h3>@SystemName</h3>
            <p>Current system state probe.</p>
        </div>

        <span class="pika-status-badge @_messageCardColor">@_badgeText</span>
    </article>
}
else
{
    <div class="pika-status-item">
        <ProgressSpinner PromptText="Loading details..." />
    </div>
}

@code{
    [Parameter]
    public string SystemName { get; set; }
    private string _messageCardColor = "";
    private string _badgeText = "Unknown";

    private bool _isLoaded;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var (_, text) = await MessageService.GetSystemStateText(SystemName);
            _badgeText = string.IsNullOrWhiteSpace(text) ? "Unknown" : text;
            _messageCardColor = _badgeText.Equals("Graceful", StringComparison.OrdinalIgnoreCase)
                ? "pika-status-badge-ok"
                : "pika-status-badge-issue";
        }
        catch
        {
            _messageCardColor = "pika-status-badge-neutral";
            _badgeText = "Unknown";
        }

        _isLoaded = true;
    }
}
