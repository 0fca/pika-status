@page "/Messages/{SystemName}"
@using PikaStatus.Models
@inject Services.MessageService MessageService
@using PikaStatus.Components
@using Pika.Domain.Status.Models
@using Pika.Domain.Status.Data

<PageTitle>PikaCloud :: Messages :: @SystemName</PageTitle>

<div class="pika-page">
    <PikaCloudHeader />

    <main class="pika-shell">
        <section class="pika-view-panel" aria-labelledby="messages-title">
            <div class="pika-view-hero">
                <div>
                    <p class="pika-section-label">MESSAGE STREAM</p>
                    <h1 id="messages-title">@SystemName</h1>
                    <p class="pika-view-copy">
                        Historical system messages, issue signals and update timestamps for this node.
                    </p>
                </div>

                <a class="pika-button pika-button-secondary" href="/status">Back to status</a>
            </div>

            @if (_messageEntities != null)
            {
                <p class="pika-view-summary">@_messageEntities.Count entries loaded.</p>
            }
        </section>

        @if (_messageEntities != null && _messageEntities.Count > 0)
        {
            <section class="pika-message-grid" aria-label="System messages">
                @foreach (var message in _messageEntities)
                {
                    var messageType = ValidateMessageType(message.MessageType);
                    <article class="pika-message-card">
                        <div class="pika-message-card-header">
                            <span class="pika-status-badge @GetBadgeClass(messageType)">@messageType</span>
                            <span class="pika-inline-meta">ID @message.Id</span>
                        </div>

                        <h2>@message.Message</h2>

                        <dl class="pika-message-meta">
                            <div>
                                <dt>Created</dt>
                                <dd>@FormatDate(message.CreatedAt)</dd>
                            </div>
                            <div>
                                <dt>Updated</dt>
                                <dd>@FormatDate(message.UpdatedAt)</dd>
                            </div>
                        </dl>

                        @if (message.MessageType == MessageType.Issue)
                        {
                            <div class="pika-message-actions">
                                <a class="pika-inline-link" href="/@SystemName/Messages/@message.Id/Issues">View issues ↗</a>
                            </div>
                        }
                    </article>
                }
            </section>
        }
        else if (_messageEntities != null)
        {
            <DataNotAvailable />
        }
        else
        {
            <ProgressSpinner PromptText="Loading system messages..." />
        }
    </main>

    <PikaCloudFooter />
</div>

@code{
    [Parameter]
    public string SystemName { get; set; }
    private Tuple<bool,List<MessageEntity>> _messageTuple;
    private List<MessageEntity>? _messageEntities = null;

    protected override async Task OnInitializedAsync()
    {
        _messageTuple = await MessageService.GetMessages(SystemName);
        _messageEntities ??= _messageTuple.Item2;
    }

    private static MessageType ValidateMessageType(MessageType messageType)
    {
        var enumVals = typeof(MessageType).GetEnumValues();
        foreach (var enumVal in enumVals)
        {
            if (enumVal.Equals(messageType))
            {
                return (MessageType)enumVal;
            }
        }
        return MessageType.None;
    }

    private static string FormatDate(DateTime dateTime)
    {
        return dateTime.ToString("dd.MM.yyyy HH:mm");
    }

    private static string GetBadgeClass(MessageType messageType)
    {
        return messageType switch
        {
            MessageType.Info => "pika-status-badge-ok",
            MessageType.Issue => "pika-status-badge-issue",
            _ => "pika-status-badge-neutral"
        };
    }

}