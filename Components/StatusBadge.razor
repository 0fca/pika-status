@namespace PikaStatus.Components

<div class="status-badge-container" style="margin-right: 10px;">
    <div class="status-badge status-badge-@Status.ToLower()" data-tooltip="@TooltipText">
        <svg class="status-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            @if (Status == "Graceful")
            {
                <!-- Check Icon -->
                <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z" fill="currentColor"/>
            }
            else
            {
                <!-- Close/Cross Icon -->
                <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12 19 6.41z" fill="currentColor"/>
            }
        </svg>
    </div>
</div>

@code {
    [Parameter]
    public string Status { get; set; } = "Graceful";
    
    [Parameter]
    public string TooltipText { get; set; } = "Graceful";
}
